# PostgreSQL used by the local collection worker.
POSTGRES_USER=threat_ingest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=threat_ioc
DATABASE_URL=postgresql+psycopg://threat_ingest:change-me@localhost:5432/threat_ioc

# Collection behavior. Do not put feed credentials in source control.
COLLECTION_TIMEOUT_SECONDS=20
COLLECTION_MAX_RETRIES=3
COLLECTION_RATE_LIMIT_PER_MINUTE=30
COLLECTION_SCHEDULE_MINUTES=60