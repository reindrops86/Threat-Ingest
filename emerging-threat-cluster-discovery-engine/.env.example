# PostgreSQL used by the local collection worker.
POSTGRES_USER=threat_ingest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=threat_ioc
DATABASE_URL=postgresql+psycopg://threat_ingest:change-me@localhost:5432/threat_ioc

# Required by the ThreatFox, URLhaus, and MalwareBazaar community APIs.
# Obtain one from https://auth.abuse.ch/ and keep it out of source control.
ABUSE_CH_AUTH_KEY=

# Collection behavior. Do not put feed credentials in source control.
COLLECTION_TIMEOUT_SECONDS=20
COLLECTION_MAX_RETRIES=3
COLLECTION_RATE_LIMIT_PER_MINUTE=30
COLLECTION_SCHEDULE_MINUTES=60

# Optional OSINT enrichment providers. RDAP/ip-api and DNS-over-HTTPS work without
# a key. urlscan.io search works keyless but is rate limited; a key raises the
# limit. GreyNoise's community lookup requires a free key or the provider is skipped.
GREYNOISE_API_KEY=
URLSCAN_API_KEY=
ENRICHMENT_BATCH_LIMIT=25

# Vulnerability intelligence. CISA KEV and EPSS are free/keyless. NVD works
# keyless but with a much lower rate limit; get a free key from
# https://nvd.nist.gov/developers/request-an-api-key for per-CVE lookups.
NVD_API_KEY=
EPSS_BATCH_SIZE=100

# Censys Platform (https://platform.censys.io/). Personal access tokens start
# with "censys_". Powers ASN/geo/threat-label host enrichment (free, high-volume
# endpoint). CENSYS_ENABLE_CERT_PIVOT additionally looks up other hosts sharing a
# discovered TLS certificate, but requires the paid Adversary Investigation module.
CENSYS_PERSONAL_ACCESS_TOKEN=
CENSYS_ORGANIZATION_ID=
CENSYS_ENABLE_CERT_PIVOT=false

# Shodan (https://account.shodan.io/). Host lookup surfaces open ports/services,
# TLS certificate fingerprints, and any CVEs Shodan has flagged as exposed on the
# host — cross-referenced against the local KEV catalog in the report.
SHODAN_API_KEY=

# Multi-source reputation. AlienVault OTX pulse correlation (free account) and
# AbuseIPDB community abuse scoring (free tier). Both are skipped without a key.
OTX_API_KEY=
ABUSEIPDB_API_KEY=